# Modelo de configuração do roboflow_sync.py.
# Copie este arquivo para rotulacao/roboflow.env e preencha os valores. O roboflow.env
# fica fora do controle de versão porque guarda a chave da API; este modelo não contém segredo.

# Chave privada da API do Roboflow, obtida em app.roboflow.com → Settings → API Keys.
# Obrigatória para os comandos enviar e baixar.
ROBOFLOW_API_KEY=

# Identificador (slug) do workspace no Roboflow. Vazio usa o workspace padrão da conta.
ROBOFLOW_WORKSPACE=

# Projeto de detecção de objetos usado como padrão de --projeto. Se ainda não existir no
# workspace, o script o cria no primeiro envio.
ROBOFLOW_PROJETO=fase6
